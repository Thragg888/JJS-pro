local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getPG() return LocalPlayer:FindFirstChild("PlayerGui") end

local function pressKey(key, hold)
    pcall(function() VirtualInput:SendKeyEvent(true, key, false, game) end)
    task.wait(hold or 0.05)
    pcall(function() VirtualInput:SendKeyEvent(false, key, false, game) end)
end

local function fireSignal(sig)
    if not sig then return false end
    if type(firesignal) == "function" then
        local ok = pcall(firesignal, sig); if ok then return true end
    end
    return (pcall(function() sig:Fire() end))
end

local function tapButton(btn, hold)
    if not btn then return false end
    fireSignal(btn.MouseButton1Down)
    fireSignal(btn.Activated)
    fireSignal(btn.MouseButton1Click)
    task.delay(hold or 0.06, function() fireSignal(btn.MouseButton1Up) end)
    return true
end

local function scanButtons()
    local pg = getPG(); local out = {}
    if not pg then return out end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton"))
           and d.Visible and d.AbsoluteSize.Magnitude > 15 then
            table.insert(out, d)
        end
    end
    return out
end

local function findButtonByKeywords(keywords)
    for _, btn in ipairs(scanButtons()) do
        local hay = btn.Name:lower()
        if btn:IsA("TextButton") then hay = hay .. " " .. (btn.Text or ""):lower() end
        for _, kw in ipairs(keywords) do
            if hay:find(kw:lower(), 1, true) then return btn end
        end
    end
    return nil
end

local function getHotbarButtons()
    local list = {}
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
    local yThreshold = vp and (vp.Y * 0.45) or 300
    for _, btn in ipairs(scanButtons()) do
        if btn.AbsolutePosition.Y > yThreshold then table.insert(list, btn) end
    end
    table.sort(list, function(a, b) return a.AbsolutePosition.X < b.AbsolutePosition.X end)
    return list
end

