local camManualTarget, camCurrent = nil, nil

local function camTarget()
    if CONFIG.CamMode == "Nearest" then return closestEntity(CONFIG.CamRange) end
    if CONFIG.CamMode == "Crosshair" then
        if camCurrent and camCurrent.Parent then
            local h = camCurrent:FindFirstChildOfClass("Humanoid")
            local r = camCurrent:FindFirstChild("HumanoidRootPart")
            local m = getHRP()
            if h and h.Health > 0 and r and m
               and (r.Position-m.Position).Magnitude <= CONFIG.CamRange then
                return camCurrent
            end
        end
        camCurrent = crosshairEntity(CONFIG.CamRange); return camCurrent
    end
    if camManualTarget and camManualTarget.Character then return camManualTarget.Character end
    return nil
end

RunService.RenderStepped:Connect(function()
    -- 1) Camera lock
    if CONFIG.CamLockEnabled then
        local t = camTarget()
        if t then
            local r = t:FindFirstChild("HumanoidRootPart")
            if r then
                local cam = workspace.CurrentCamera
                local want = CFrame.lookAt(cam.CFrame.Position, r.Position)
                cam.CFrame = CONFIG.CamSmooth and cam.CFrame:Lerp(want, 0.25) or want
            end
        end
    end

    -- 2) Body rotation (predict > shiftlock > normal)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        setAutoRotate(true); return
    end

    -- Invalidate predict if target gone
    if predictTarget and tick() < predictEnd then
        local pr = predictTarget:FindFirstChild("HumanoidRootPart")
        local ph = predictTarget:FindFirstChildOfClass("Humanoid")
        if not pr or not ph or ph.Health <= 0 then predictTarget = nil end
    end

    local usePredict = predictTarget and tick() < predictEnd

    if usePredict then
        setAutoRotate(false)
        local pr = predictTarget:FindFirstChild("HumanoidRootPart")
        if pr then
            local look = Vector3.new(pr.Position.X, hrp.Position.Y, pr.Position.Z)
            if (look - hrp.Position).Magnitude > 0.1 then
                hrp.CFrame = CFrame.lookAt(hrp.Position, look)
            end
        end
    elseif CONFIG.ShiftlockEnabled then
        setAutoRotate(false)
        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
        end
    else
        setAutoRotate(true)
    end
end)

