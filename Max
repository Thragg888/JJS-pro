-- Drag + click toggle
local btnDragging  = false
local btnDragStart, btnStartPos
local btnMoved     = false
local DRAG_THRESHOLD = 5

local function setCamLock(state)
    camLockEnabled = state
    if state then
        camLockMode = "Crosshair"
        camLockCurrentTarget = getEntityInCrosshair(camLockRange)
        Btn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
        btnStroke.Color = Color3.fromRGB(100, 220, 130)
    else
        camLockCurrentTarget = nil
        Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        btnStroke.Color = Color3.fromRGB(100, 100, 120)
    end
    Crosshair.Visible = state
end

Btn.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    btnDragging = true
    btnMoved = false
    btnDragStart = input.Position
    btnStartPos = Btn.Position
    local conn
    conn = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            btnDragging = false
            if conn then conn:Disconnect() end
            if not btnMoved then
                setCamLock(not camLockEnabled)
            end
        end
    end)
end)

UserInputService.InputChanged:Connect(function(input)
    if not btnDragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = input.Position - btnDragStart
    if math.abs(d.X) > DRAG_THRESHOLD or math.abs(d.Y) > DRAG_THRESHOLD then
        btnMoved = true
    end
    if btnMoved then
        Btn.Position = UDim2.new(
            btnStartPos.X.Scale, btnStartPos.X.Offset + d.X,
            btnStartPos.Y.Scale, btnStartPos.Y.Offset + d.Y
        )
    end
end)

