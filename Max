local lastAutoAttack, lastDodge = 0, 0

RunService.Heartbeat:Connect(function()
    -- Block release
    if blockHeld then
        if tick() >= blockReleaseAt or (tick() - blockStart) >= CONFIG.BlockMaxContinuous then
            releaseBlock()
        end
    end

    local char = LocalPlayer.Character; if not char then return end
    local hrp = getHRP()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    -- NEW: Predict block scan
    if CONFIG.PredictBlockEnabled then
        refreshEntities()
        local attacker = checkDashPrediction()
        if attacker then triggerPredict(attacker) end
        -- Ensure block stays active through predict window
        if predictTarget and tick() < predictEnd and not blockHeld then
            triggerBlock()
        end
    end

    if CONFIG.AutoDodgeEnabled and tick() - lastDodge > 0.15 then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
            lastDodge = tick()
            pcall(function() VirtualInput:SendKeyEvent(true, Enum.KeyCode.Q, false, game) end)
            task.delay(0.05, function()
                pcall(function() VirtualInput:SendKeyEvent(false, Enum.KeyCode.Q, false, game) end)
            end)
        end
    end

    if CONFIG.AutoAttackEnabled and tick() - lastAutoAttack > 0.12 then
        local t = closestEntity(20)
        if t then
            local r = t:FindFirstChild("HumanoidRootPart")
            if r then
                lastAutoAttack = tick()
                hrp.CFrame = CFrame.new(hrp.Position, r.Position)
                pcall(function() VirtualInput:SendMouseButtonEvent(0,0,0,true,game,0) end)
                task.delay(0.06, function()
                    pcall(function() VirtualInput:SendMouseButtonEvent(0,0,0,false,game,0) end)
                end)
            end
        end
    end

    if CONFIG.KillAuraEnabled then
        refreshEntities()
        for _, c in ipairs(entityCache) do
            local h, r = c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 and (r.Position - hrp.Position).Magnitude < 10 then
                h:TakeDamage(5)
            end
        end
    end
end)

