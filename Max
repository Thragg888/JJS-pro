local KEY_BY_SLOT = {
    ["1"] = Enum.KeyCode.One,  ["2"] = Enum.KeyCode.Two,
    ["3"] = Enum.KeyCode.Three,["4"] = Enum.KeyCode.Four,
    ["R"] = Enum.KeyCode.R,    ["F"] = Enum.KeyCode.F,
}

local function useSlot(slot, hold)
    if isPC or isHybrid then
        local key = KEY_BY_SLOT[slot]
        if key then pressKey(key, hold or 0.05); return true end
    end
    if isMobile or isHybrid then
        local dc = detectedCounter
        if dc and dc.key and dc.key ~= "manual" then
            local btn = findButtonByKeywords({ dc.key })
            if tapButton(btn, hold) then return true end
        end
        local named = findButtonByKeywords({ "skill" .. slot, "skill " .. slot, slot })
        if tapButton(named, hold) then return true end
        if CONFIG.CounterUseMobilePos then
            local idx = tonumber(slot)
            if idx then
                local hb = getHotbarButtons()
                if hb[idx] then return tapButton(hb[idx], hold) end
            end
        end
    end
    return false
end

-- ============================================================
-- BLOCK (1s hold)
-- ============================================================
local blockHeld, blockStart, blockReleaseAt = false, 0, 0
local cachedBlockBtn = nil

local function blockButton()
    if cachedBlockBtn and cachedBlockBtn.Parent then return cachedBlockBtn end
    cachedBlockBtn = findButtonByKeywords({ "block", "guard", "parry", "shield", "defend" })
    return cachedBlockBtn
end

local function blockOn()
    if isPC or isHybrid then
        pcall(function() VirtualInput:SendKeyEvent(true, CONFIG.BlockKey, false, game) end)
    end
    if isMobile or isHybrid then
        local b = blockButton()
        if b then fireSignal(b.MouseButton1Down); fireSignal(b.Activated) end
    end
end

local function blockOff()
    if isPC or isHybrid then
        pcall(function() VirtualInput:SendKeyEvent(false, CONFIG.BlockKey, false, game) end)
    end
    if isMobile or isHybrid then
        local b = blockButton()
        if b then fireSignal(b.MouseButton1Up) end
    end
end

local function releaseBlock()
    if blockHeld then blockOff(); blockHeld = false end
end

local function triggerBlock()
    if blockHeld then
        if (tick() - blockStart) >= CONFIG.BlockMaxContinuous then releaseBlock() end
        blockReleaseAt = tick() + CONFIG.BlockHoldTime
        return
    end
    blockHeld = true
    blockStart = tick()
    blockReleaseAt = tick() + CONFIG.BlockHoldTime
    blockOn()
end

