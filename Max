local esp = {}
local function updateESP()
    for p, h in pairs(esp) do
        if not CONFIG.ESPEnabled or not p.Character then h:Destroy(); esp[p] = nil end
    end
    if CONFIG.ESPEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not esp[p] then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.fromRGB(255,60,60)
                h.FillTransparency, h.OutlineColor = 0.6, Color3.new(1,1,1)
                h.Parent = p.Character; esp[p] = h
            end
        end
    end
end

