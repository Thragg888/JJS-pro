-- ENTITY CACHE
-- ============================================================
local entityCache, lastCache = {}, 0
local function refreshEntities()
    if tick() - lastCache < 0.2 then return end
    lastCache = tick(); entityCache = {}
    local myChar = LocalPlayer.Character
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= myChar then
            local h = obj.Parent:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then table.insert(entityCache, obj.Parent) end
        end
    end
end

local function closestEntity(maxDist)
    refreshEntities()
    local myHRP = getHRP(); if not myHRP then return nil end
    local best, bd = nil, maxDist
    for _, c in ipairs(entityCache) do
        local r = c:FindFirstChild("HumanoidRootPart")
        if r then
            local d = (r.Position - myHRP.Position).Magnitude
            if d < bd then bd = d; best = c end
        end
    end
    return best
end

local function crosshairEntity(maxDist)
    local cam, myHRP = workspace.CurrentCamera, getHRP()
    if not cam or not myHRP then return nil end
    local vp = cam.ViewportSize; local cx, cy = vp.X/2, vp.Y/2
    refreshEntities()
    local best, bsd = nil, math.huge
    for _, c in ipairs(entityCache) do
        local r = c:FindFirstChild("HumanoidRootPart")
        if r and (r.Position - myHRP.Position).Magnitude <= maxDist then
            local sp, on = cam:WorldToViewportPoint(r.Position)
            if on and sp.Z > 0 then
                local dx, dy = sp.X - cx, sp.Y - cy
                local sd = math.sqrt(dx*dx + dy*dy)
                if sd < bsd then bsd = sd; best = c end
            end
        end
    end
    return best
end

