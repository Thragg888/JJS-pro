-- ============================================================
-- ENTITY CACHE
-- ============================================================
local entityCache     = {}
local lastCacheUpdate = 0
local CACHE_INTERVAL  = 0.3

local function refreshEntityCache()
    if tick() - lastCacheUpdate < CACHE_INTERVAL then return end
    lastCacheUpdate = tick()
    entityCache = {}
    local myChar = LocalPlayer.Character
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= myChar then
            local hum = obj.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(entityCache, obj.Parent)
            end
        end
    end
end

local function getClosestEntity(maxDist)
    refreshEntityCache()
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local best, bestDist = nil, maxDist
    for _, char in ipairs(entityCache) do
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and char.Parent then
            local d = (hrp.Position - myHRP.Position).Magnitude
            if d < bestDist then bestDist = d; best = char end
        end
    end
    return best, bestDist
end

-- Crosshair targeting: entity nearest to screen center
local function getEntityInCrosshair(maxDist)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local viewport = cam.ViewportSize
    local cx, cy = viewport.X / 2, viewport.Y / 2

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    refreshEntityCache()
    local best, bestScreenDist = nil, math.huge

    for _, char in ipairs(entityCache) do
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local worldDist = (hrp.Position - myHRP.Position).Magnitude
            if worldDist <= maxDist then
                local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen and sp.Z > 0 then
                    local dx, dy = sp.X - cx, sp.Y - cy
                    local screenDist = math.sqrt(dx*dx + dy*dy)
                    if screenDist < bestScreenDist then
                        bestScreenDist = screenDist
                        best = char
                    end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- CAM TARGET RESOLUTION
-- ============================================================
local function resolveCamTarget()
    if camLockMode == "Nearest" then
        return getClosestEntity(camLockRange)
    end
    if camLockMode == "Crosshair" then
        -- Validate cached target
        if camLockCurrentTarget and camLockCurrentTarget.Parent then
            local hum  = camLockCurrentTarget:FindFirstChildOfClass("Humanoid")
            local ehrp = camLockCurrentTarget:FindFirstChild("HumanoidRootPart")
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and ehrp and myHRP then
                if (ehrp.Position - myHRP.Position).Magnitude <= camLockRange then
                    return camLockCurrentTarget
                end
            end
        end
        camLockCurrentTarget = getEntityInCrosshair(camLockRange)
        return camLockCurrentTarget
    end
    -- Specific Player
    if camLockTarget and camLockTarget.Character then
        local hrp = camLockTarget.Character:FindFirstChild("HumanoidRootPart")
        if hrp then return camLockTarget.Character end
    end
    return nil
end

-- ============================================================
-- CORE HELPERS
-- ============================================================
local function triggerBlock()
    if blockHeld then
        blockReleaseToken = blockReleaseToken + 1
        local t = blockReleaseToken
        task.delay(blockHoldTime, function()
            if blockReleaseToken == t then
                VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                blockHeld = false
            end
        end)
        return
    end
    VirtualInput:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    blockHeld = true
    blockReleaseToken = blockReleaseToken + 1
    local t = blockReleaseToken
    task.delay(blockHoldTime, function()
        if blockReleaseToken == t then
            VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            blockHeld = false
        end
    end)
end

local function releaseBlockNow()
    blockReleaseToken = blockReleaseToken + 1
    if blockHeld then
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        blockHeld = false
    end
end

local function pressKey(key, holdTime)
    VirtualInput:SendKeyEvent(true, key, false, game)
    task.wait(holdTime or 0.05)
    VirtualInput:SendKeyEvent(false, key, false, game)
end

local function tryCounter()
    if not autoCounterEnabled then return false end
    if tick() < counterCooldownEnd then return false end
    pressKey(counterKey, 0.05)
    counterCooldownEnd = tick() + counterCooldownTime
    return true
end

local function attemptPerfectBlockBF()
    if not autoPerfectBlockBF then return false end
    if tick() - lastPerfectBlock < perfectBlockCooldown then return false end
    VirtualInput:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.03)
    VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    task.wait(0.02)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    lastPerfectBlock = tick()
    return true
end

local function onBlockableDetected()
    if tryCounter() then return end
    if attemptPerfectBlockBF() then return end
    if autoBlockEnabled then triggerBlock() end
end

-- ============================================================
-- ANIMATION LISTENER
-- ============================================================
local function setupEntityListener(char)
    if not char or not char:FindFirstChild("Humanoid") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChild("Animator")
    if not animator then return end
    if activeAnimConnections[char] then return end

    activeAnimConnections[char] = animator.AnimationPlayed:Connect(function(track)
        if not (autoBlockEnabled or autoCounterEnabled or autoPerfectBlockBF) then return end
        if not LocalPlayer.Character then return end
        local anim = track.Animation
        if not anim then return end
        local id = (anim.AnimationId or ""):match("%d+")
        if not id then return end
        if UNBLOCKABLE_BLACKLIST[id] then
            if autoPerfectBlockBF then attemptPerfectBlockBF() end
            return
        end
        if not BLOCKABLE_ANIM_IDS[id] then return end
        local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local eHRP  = char:FindFirstChild("HumanoidRootPart")
        if not myHRP or not eHRP then return end
        if (eHRP.Position - myHRP.Position).Magnitude > blockDetectRange then return end
        onBlockableDetected()
    end)
end

local function scanAllEntities()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= LocalPlayer.Character then
            local char = obj.Parent
            if char:FindFirstChildOfClass("Humanoid") then
                setupEntityListener(char)
            end
        end
    end
end

scanAllEntities()
workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "HumanoidRootPart" then
        task.wait(0.5)
        local char = obj.Parent
        if char and char:FindFirstChildOfClass("Humanoid") then
            setupEntityListener(char)
        end
    end
end)

-- ============================================================
-- BF CHAIN (3-key trigger)
-- ============================================================
local function attemptBFC()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local target = getClosestEntity(bfRange)
    if not target then
        print("[BFC] No target within " .. bfRange .. " studs.")
        return
    end
    local eHRP = target:FindFirstChild("HumanoidRootPart")
    if not eHRP then return end
    print("[BFC] → " .. target.Name)
    if bfDashFirst then
        pressKey(Enum.KeyCode.Q, 0.08)
        task.wait(0.10)
    end
    if bfTeleportBehind then
        myHRP.CFrame = eHRP.CFrame * CFrame.new(0, 0, 3.5)
    end
    myHRP.CFrame = CFrame.new(myHRP.Position, eHRP.Position)
    task.wait(0.05)
    pressKey(bfAttackKey, bfDoubleTapDelay)
    task.wait(bfTiming)
    pressKey(bfAttackKey, bfDoubleTapDelay)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode ~= Enum.KeyCode.Three then return end
    if bfChainRunning then return end
    local target = getClosestEntity(bfRange)
    if not target then return end
    bfChainRunning = true
    task.spawn(function()
        pcall(attemptBFC)
        bfChainRunning = false
    end)
end)

