-- NEW: dash prediction
-- ============================================================
local function checkDashPrediction()
    local myHRP = getHRP()
    if not myHRP then return nil end
    local myLook = myHRP.CFrame.LookVector
    local best, bestScore = nil, -math.huge
    for _, char in ipairs(entityCache) do
        local r = char:FindFirstChild("HumanoidRootPart")
        local h = char:FindFirstChildOfClass("Humanoid")
        if r and h and h.Health > 0 then
            local vel = r.AssemblyLinearVelocity
            local speed = vel.Magnitude
            if speed >= CONFIG.PredictMinSpeed then
                local toMe = myHRP.Position - r.Position
                local dist = toMe.Magnitude
                if dist <= CONFIG.PredictRange and dist > 0.5 then
                    local future = r.Position + vel * CONFIG.PredictLookahead
                    local futureDir = (future - myHRP.Position).Unit
                    local futureDot = myLook:Dot(futureDir)
                    if futureDot < CONFIG.PredictFrontThreshold then
                        local score = (CONFIG.PredictRange - dist) + (CONFIG.PredictFrontThreshold - futureDot) * 50
                        if score > bestScore then bestScore = score; best = char end
                    end
                end
            end
        end
    end
    return best
end

local function triggerPredict(attacker)
    if predictTarget == attacker and tick() < predictEnd then
        predictEnd = tick() + CONFIG.PredictDuration
        return
    end
    predictTarget = attacker
    predictEnd = tick() + CONFIG.PredictDuration
    triggerBlock()
end

