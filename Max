-- ============================================================
-- CORE HELPERS
-- ============================================================
local function triggerBlock()
    if blockHeld then
        blockReleaseToken = blockReleaseToken + 1
        local myToken = blockReleaseToken
        task.delay(blockHoldTime, function()
            if blockReleaseToken == myToken then
                VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                blockHeld = false
            end
        end)
        return
    end
    VirtualInput:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    blockHeld = true
    blockReleaseToken = blockReleaseToken + 1
    local myToken = blockReleaseToken
    task.delay(blockHoldTime, function()
        if blockReleaseToken == myToken then
            VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            blockHeld = false
        end
    end)
end

local function releaseBlockNow()
    blockReleaseToken = blockReleaseToken + 1
    if blockHeld then
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        blockHeld = false
    end
end

local function pressKey(key, holdTime)
    VirtualInput:SendKeyEvent(true, key, false, game)
    task.wait(holdTime or 0.05)
    VirtualInput:SendKeyEvent(false, key, false, game)
end

-- Universal entity scan (works on players, dummies, NPCs)
local function getClosestEntity(maxDist)
    local best, bestDist = nil, maxDist
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    -- Scan ALL descendants for HumanoidRootParts (covers dummies/NPCs)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= myChar then
            local hum = obj.Parent:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                -- Skip if it's a player (players are handled separately, but this catches them too)
                local d = (obj.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = obj.Parent -- Return the character model
                end
            end
        end
    end
    return best, bestDist
end

local function tryCounter()
    if not autoCounterEnabled then return false end
    if tick() < counterCooldownEnd then return false end
    pressKey(counterKey, 0.05)
    counterCooldownEnd = tick() + counterCooldownTime
    return true
end

local function onBlockableDetected()
    if tryCounter() then return end
    if autoBlockEnabled then triggerBlock() end
end

-- ============================================================
-- PERFECT BLOCK BLACK FLASH
-- ============================================================
local function attemptPerfectBlockBF()
    if not autoPerfectBlockBF then return end
    if tick() - lastPerfectBlock < perfectBlockCooldown then return end

    -- Press F (block) briefly
    VirtualInput:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.03)
    VirtualInput:SendKeyEvent(false, Enum.KeyCode.F, false, game)

    -- Immediately press M1
    task.wait(0.02)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)

    lastPerfectBlock = tick()
    print("[PerfectBlockBF] Attempted F -> M1 counter.")
end

-- ============================================================
-- ANIMATION LISTENER (Works on all entities)
-- ============================================================
local function setupEntityListener(entity)
    local char = entity
    if not char or not char:FindFirstChild("Humanoid") then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum:FindFirstChild("Animator")
    if not animator then return end

    -- Avoid duplicate connections
    if activeAnimConnections[char] then return end

    activeAnimConnections[char] = animator.AnimationPlayed:Connect(function(track)
        if not (autoBlockEnabled or autoCounterEnabled or autoPerfectBlockBF) then return end
        if not LocalPlayer.Character then return end

        local anim = track.Animation
        if not anim then return end
        local id = (anim.AnimationId or ""):match("%d+")
        if not id then return end

        -- Blacklist check
        if UNBLOCKABLE_BLACKLIST[id] then
            if autoPerfectBlockBF then attemptPerfectBlockBF() end
            return
        end

        if not BLOCKABLE_ANIM_IDS[id] then return end

        local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local eHRP  = char:FindFirstChild("HumanoidRootPart")
        if not myHRP or not eHRP then return end
        if (eHRP.Position - myHRP.Position).Magnitude > blockDetectRange then return end

        -- If Perfect Block BF is on and the move is blockable, try the F->M1 counter first
        if autoPerfectBlockBF then
            attemptPerfectBlockBF()
        else
            onBlockableDetected()
        end
    end)
end

-- Hook all current and future entities
local function scanAllEntities()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= LocalPlayer.Character then
            local char = obj.Parent
            if char:FindFirstChildOfClass("Humanoid") then
                setupEntityListener(char)
            end
        end
    end
end

scanAllEntities()
workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "HumanoidRootPart" then
        task.wait(1) -- Wait for character to load
        local char = obj.Parent
        if char and char:FindFirstChildOfClass("Humanoid") then
            setupEntityListener(char)
        end
    end
end)

-- ============================================================
-- BF CHAIN
-- ============================================================
local function attemptBFC()
    if not autoBFCEnabled then return end
    if tick() < bfCooldownEnd then return end

    local target, dist = getClosestEntity(bfRange)
    if not target then return end

    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local eHRP  = target:FindFirstChild("HumanoidRootPart")
    if not myHRP or not eHRP then return end

    bfCooldownEnd = tick() + bfCooldownTime
    print("[BFC] → " .. target.Name)

    if bfDashFirst then
        pressKey(Enum.KeyCode.Q, 0.08)
        task.wait(0.10)
    end

    if bfTeleportBehind then
        myHRP.CFrame = eHRP.CFrame * CFrame.new(0, 0, 3.5)
    end
    myHRP.CFrame = CFrame.new(myHRP.Position, eHRP.Position)
    task.wait(0.05)

    -- First press (Divergent Fist)
    pressKey(bfAttackKey, bfDoubleTapDelay)
    -- Wait for Black Flash window
    task.wait(bfTiming)
    -- Second press (Black Flash timing)
    pressKey(bfAttackKey, bfDoubleTapDelay)
end

-- ============================================================
-- ESP
-- ============================================================
local function updateESP()
    for plr, hl in pairs(espHighlights) do
        if not espEnabled or not plr.Character then
            if hl then hl:Destroy() end
            espHighlights[plr] = nil
        end
    end
    if espEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                if not espHighlights[plr] then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(255, 60, 60)
                    hl.FillTransparency = 0.6
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = plr.Character
                    espHighlights[plr] = hl
                end
            end
        end
    end
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
RunService.Heartbeat:Connect(function()
    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    -- Auto Dodge
    if autoDodgeEnabled then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
            pressKey(Enum.KeyCode.Q, 0.05)
        end
    end

    -- Auto Attack
    if autoAttackEnabled then
        local target = getClosestEntity(20)
        if target then
            local eHRP = target:FindFirstChild("HumanoidRootPart")
            if eHRP then
                hrp.CFrame = CFrame.new(hrp.Position, eHRP.Position)
                VirtualInput:SendMouseButtonEvent(0, 0, 0, true,  game, 0)
                task.wait(0.1)
                VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
    end

    -- Kill Aura
    if killAuraEnabled then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "HumanoidRootPart" and obj.Parent ~= LocalPlayer.Character then
                local eHum = obj.Parent:FindFirstChildOfClass("Humanoid")
                if eHum and eHum.Health > 0 and (obj.Position - hrp.Position).Magnitude < 10 then
                    eHum:TakeDamage(5)
                end
            end
        end
    end

    -- BF Chain loop
    if autoBFCEnabled then attemptBFC() end
end)

