-- ANIMATION LISTENER
-- ============================================================
local conns = {}
local function listen(char)
    if not char or conns[char] then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChild("Animator")
    if not animator then return end
    conns[char] = animator.AnimationPlayed:Connect(function(track)
        if not (CONFIG.AutoBlockEnabled or CONFIG.AutoCounterEnabled or CONFIG.PBFEnabled) then return end
        local anim = track.Animation; if not anim then return end
        local id = (anim.AnimationId or ""):match("%d+")
        if not id or not BLOCKABLE_ANIM_IDS[id] then return end
        local myHRP, eHRP = getHRP(), char:FindFirstChild("HumanoidRootPart")
        if not myHRP or not eHRP then return end
        if (eHRP.Position - myHRP.Position).Magnitude > CONFIG.BlockDetectRange then return end
        onBlockable(char)
    end)
end

local function scanEntities()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= LocalPlayer.Character
           and obj.Parent:FindFirstChildOfClass("Humanoid") then listen(obj.Parent) end
    end
end
