local function animatorOf()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h:FindFirstChildOfClass("Animator")
end
local function alive(m)
    if m == LocalPlayer.Character then return false end
    local r, h = m:FindFirstChild("HumanoidRootPart"), m:FindFirstChild("Humanoid")
    return r and h and h.Health > 0
end
local function facingAway(root)
    local hrp = getHRP()
    if not hrp or not root or not root.Parent then return false end
    local v = hrp.Position - root.Position
    if v.Magnitude < 0.01 then return false end
    return root.CFrame.LookVector:Dot(v.Unit) < CONFIG.FacingDotThreshold
end
local function nearestTarget()
    local hrp = getHRP(); if not hrp then return nil end
    local best, bd = nil, math.huge
    local function chk(m)
        if not alive(m) then return end
        local r = m:FindFirstChild("HumanoidRootPart"); if not r then return end
        local d = (hrp.Position - r.Position).Magnitude
        if d < bd then bd = d; best = m end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then chk(p.Character) end
    end
    for _, o in ipairs(workspace:GetDescendants()) do if o:IsA("Model") then chk(o) end end
    return best
end
local function trail(root)
    local a0, a1 = Instance.new("Attachment", root), Instance.new("Attachment", root)
    a1.Position = Vector3.new(0,2,0)
    local t = Instance.new("Trail", root)
    t.Attachment0, t.Attachment1 = a0, a1
    t.Color = ColorSequence.new(Color3.new(1,1,1))
    t.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1)})
    t.Lifetime, t.MinLength, t.FaceCamera = CONFIG.TrailLifetime, 0, true
    task.delay(CONFIG.TrailLifetime + 0.1, function() t:Destroy(); a0:Destroy(); a1:Destroy() end)
end
local function dashAnim(dir, dur)
    local an = animatorOf(); if not an then return nil end
    local id = (dir == "Left") and CONFIG.DashAnimLeft or CONFIG.DashAnimRight
    if not animCache[dir] then
        local a = Instance.new("Animation"); a.AnimationId = id; animCache[dir] = a
    end
    local t = an:LoadAnimation(animCache[dir])
    t.Priority = Enum.AnimationPriority.Action; t:Play()
    task.delay(dur + 0.05, function() if t.IsPlaying then t:Stop(0.15) end end)
    return t
end
local function attackAnim()
    local an = animatorOf(); if not an then return end
    if not animCache.At then
        local a = Instance.new("Animation"); a.AnimationId = CONFIG.AttackAnimId; animCache.At = a
    end
    local t = an:LoadAnimation(animCache.At)
    t.Priority = Enum.AnimationPriority.Action; t:Play()
    task.delay(1.113, function() if t.IsPlaying then t:Stop() end end)
end
local function curvedDash(root)
    local hrp = getHRP(); if not hrp or not root then return end
    local from = hrp.Position
    local to = (root.CFrame * CFrame.new(0,0,CONFIG.BehindOffset)).Position
    if (from - to).Magnitude < CONFIG.AlreadyBehindTolerance then attackAnim(); return end
    local dist = (to - from).Magnitude; if dist < 0.5 then return end
    local dir = (to - from).Unit
    local side = dir:Cross(Vector3.new(0,1,0)).Unit
    local left = math.random(1,2) == 2; if left then side = -side end
    local arc = {{0.10,0.50},{0.30,0.80},{0.55,0.70},{0.75,0.40},{1.00,0}}
    local wps = {}
    for i = 1, math.min(CONFIG.ArcSegments, #arc) do
        table.insert(wps, from + dir*dist*arc[i][1] + side*dist*CONFIG.SideWidth*arc[i][2])
    end
    local total = math.max(dist / CONFIG.DashSpeed, 0.08)
    local seg = total / #wps
    trail(hrp)
    local tr = dashAnim(left and "Left" or "Right", total)
    for i, wp in ipairs(wps) do
        local look = (i < #wps) and (wps[i+1]-wp).Unit or (root.Position-wp).Unit
        TweenService:Create(hrp, TweenInfo.new(seg, Enum.EasingStyle.Linear),
            {CFrame = CFrame.new(wp, wp + look)}):Play()
        task.wait(seg)
    end
    hrp.CFrame = CFrame.lookAt(to, root.Position)
    if tr and tr.IsPlaying then tr:Stop(0.1) end
    attackAnim()
end

if fistRemote then
    local cooling, retrying = false, false
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if getnamecallmethod() ~= "FireServer" or self ~= fistRemote
           or not CONFIG.BFEnabled or cooling or retrying then
            return old(self, ...)
        end
        cooling = true
        local res = old(self, ...)
        local args = {...}
        local tgt = nearestTarget()
        local root = tgt and tgt:FindFirstChild("HumanoidRootPart")
        task.delay(CONFIG.FireDelay, function()
            if root and root.Parent and not facingAway(root) then
                if returnRemote then pcall(function() returnRemote:FireServer() end) end
                task.spawn(function()
                    task.wait(CONFIG.RetryDelay)
                    if not root.Parent or not alive(root.Parent) then cooling = false; return end
                    curvedDash(root)
                    if not facingAway(root) and CONFIG.RetryFire then
                        retrying = true
                        pcall(function() fistRemote:FireServer(table.unpack(args)) end)
                        task.wait(CONFIG.FireDelay)
                        pcall(function() fistRemote:FireServer(table.unpack(args)) end)
                        retrying = false
                    end
                    cooling = false
                end)
            else
                pcall(function() fistRemote:FireServer(table.unpack(args)) end)
                cooling = false
            end
        end)
        task.spawn(function() if root and root.Parent then curvedDash(root) end end)
        return res
    end)
    bfReady = true
end

