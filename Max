-- CHARACTER / COUNTER DETECTION
-- ============================================================
local detectedCounter, lastDetect = nil, 0

local function detectCounter(force)
    if not force and tick() - lastDetect < 1.0 then return detectedCounter end
    lastDetect = tick(); detectedCounter = nil
    local pg = getPG(); if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("ImageLabel") then
            local hay = d.Name:lower()
            if d:IsA("TextButton") or d:IsA("TextLabel") then
                hay = hay .. " " .. (d.Text or ""):lower()
            end
            for _, m in ipairs(COUNTER_MOVES) do
                if hay:find(m.key, 1, true) then
                    detectedCounter = { key = m.key, slot = m.slot, char = m.char, step2 = m.step2 }
                    return detectedCounter
                end
            end
        end
    end
    return nil
end

local function currentCounterSlot()
    if CONFIG.CounterSlotManual ~= "Auto" then
        return { key = "manual", slot = CONFIG.CounterSlotManual, char = "Manual", step2 = nil }
    end
    return detectCounter(false)
end

