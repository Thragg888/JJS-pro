-- CAM LOCK LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not camLockEnabled then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local targetChar = resolveCamTarget()
    if not targetChar then return end
    local eHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not eHRP then return end
    local cam = workspace.CurrentCamera
    local desiredCF = CFrame.lookAt(cam.CFrame.Position, eHRP.Position)
    if camLockSmooth then
        cam.CFrame = cam.CFrame:Lerp(desiredCF, 0.25)
    else
        cam.CFrame = desiredCF
    end
end)

