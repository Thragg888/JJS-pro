-- COUNTER
-- ============================================================
local counterReadyAt, lastPBF = 0, 0

local function triggerCounter()
    if not CONFIG.AutoCounterEnabled then return false end
    if tick() < counterReadyAt then return false end
    local info = currentCounterSlot()
    if not info then return false end
    counterReadyAt = tick() + CONFIG.CounterCooldown
    if info.step2 == "block" then
        useSlot(info.slot, 0.06)
        task.delay(0.30, function()
            blockOn()
            task.delay(0.55, function()
                if not blockHeld then blockOff() end
            end)
        end)
    else
        useSlot(info.slot, 0.06)
    end
    return true
end

local function tryPBF()
    if not CONFIG.PBFEnabled then return false end
    if tick() - lastPBF < CONFIG.PBFCooldown then return false end
    blockOn(); task.wait(0.03); blockOff()
    task.wait(0.02)
    pcall(function() VirtualInput:SendMouseButtonEvent(0,0,0,true,game,0) end)
    task.wait(0.05)
    pcall(function() VirtualInput:SendMouseButtonEvent(0,0,0,false,game,0) end)
    lastPBF = tick(); return true
end

local function isFacing(attackerChar)
    local myHRP = getHRP()
    local eHRP = attackerChar and attackerChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not eHRP then return true end
    local v = eHRP.Position - myHRP.Position
    if v.Magnitude < 0.1 then return true end
    return myHRP.CFrame.LookVector:Dot(v.Unit) > 0
end

local function onBlockable(attackerChar)
    if CONFIG.CounterOnlyFacing and not isFacing(attackerChar) then return end
    if CONFIG.CounterLead > 0 then task.wait(CONFIG.CounterLead) end
    if triggerCounter() then return end
    if tryPBF() then return end
    if CONFIG.AutoBlockEnabled then
        if CONFIG.BlockOnlyWhenFacing and not isFacing(attackerChar) then return end
        triggerBlock()
    end
end

